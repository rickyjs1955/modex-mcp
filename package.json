{
  "name": "@modex/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing modex authoring tools (feed, agents, bind, aspirations) to MCP hosts",
  "license": "MIT",
  "type": "module",
  "bin": {
    "modex-mcp": "./bin/modex-mcp.mjs"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "modex",
    "mcp",
    "model-context-protocol",
    "skills.md",
    "claude",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickyjs1955/modex-mcp.git"
  },
  "homepage": "https://github.com/rickyjs1955/modex-mcp#readme",
  "bugs": {
    "url": "https://github.com/rickyjs1955/modex-mcp/issues"
  },
